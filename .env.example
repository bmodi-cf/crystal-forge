# Postgres connection (matches docker-compose.yml defaults)
# Host port is 5433 because another Postgres already binds 5432 on Bhadresh's WSL host.
DATABASE_URL="postgresql://crystal:crystal@localhost:5433/crystal_forge?schema=public"

# Auth.js core
AUTH_SECRET="generate with: pnpm dlx auth secret"
NEXTAUTH_URL="http://localhost"

# Microsoft Entra ID (Azure AD) — fill from your app registration
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<your-tenant-id>/v2.0"

# Dev-only impersonation toggle (must be unset/empty in production)
AUTH_DEV_USERS_ENABLED="true"

# GitHub integration
GITHUB_CLIENT_MODE="real"
GITHUB_REPO_OWNER="bmodi-cf"
GITHUB_TEMPLATE_REPO="bmodi-cf/crystal-forge-template-webapp"
GITHUB_BASE_URL="https://github.com"
# Required when GITHUB_CLIENT_MODE=real:
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_INSTALLATION_ID=""
