# Postgres connection (matches docker-compose.yml defaults)
# Host port is 5433 because another Postgres already binds 5432 on Bhadresh's WSL host.
DATABASE_URL="postgresql://crystal:crystal@localhost:5433/crystal_forge?schema=public"

# Auth.js core
AUTH_SECRET="generate with: pnpm dlx auth secret"
# NEXTAUTH_URL is optional. Leave it unset: trustHost:true infers the origin
# from the request, which is correct for local dev on any port and behind the
# TLS reverse proxy (X-Forwarded-Host). Only set it to force a fixed public
# origin, e.g. NEXTAUTH_URL="https://forge-pilot.crystalfountains.com".

# Microsoft Entra ID (Azure AD) — fill from your app registration
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<your-tenant-id>/v2.0"

# Dev-only impersonation toggle (must be unset/empty in production)
AUTH_DEV_USERS_ENABLED="true"

# GitHub integration
GITHUB_CLIENT_MODE="real"
GITHUB_REPO_OWNER="bmodi-cf"
GITHUB_TEMPLATE_REPO="bmodi-cf/crystal-forge-template-webapp"
GITHUB_BASE_URL="https://github.com"
# Required when GITHUB_CLIENT_MODE=real:
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_INSTALLATION_ID=""
# PAT injected into each forge container as GH_TOKEN so the agent's own git/gh
# operations authenticate (the App token only clones once, then is stripped).
# Needs `repo` scope (classic) or Contents:read/write (fine-grained). Leave empty
# to disable in-forge git auth. Single shared token — fine for the pilot only.
FORGE_GIT_TOKEN=""

# On-prem Docker registry (promote-to-production). Use fake for tests/offline.
REGISTRY_CLIENT_MODE=fake
REGISTRY_HOST=registry.crystalfountains.com
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Per-forge database provisioning (defaults match docker-compose.yml).
HARNESS_PG_HOST="localhost"
HARNESS_PG_PORT="5433"
HARNESS_PG_USER="crystal"
HARNESS_PG_PASSWORD="crystal"
DB_PROVISIONER_MODE="real"

# Runtime WebSocket (embedded Claude Code terminal session)
# CRYSTAL_FORGE_WS_PORT="3100"                  # optional, defaults to 3100
CRYSTAL_FORGE_WS_SECRET=""                       # REQUIRED in production (>=16 chars); generate: openssl rand -hex 32
# Set only when behind a TLS reverse proxy that exposes the WS on the same
# origin under a path (e.g. nginx). Otherwise leave unset (direct host:port).
# CRYSTAL_FORGE_WS_PUBLIC_URL="wss://forge-pilot.crystalfountains.com/_forge-ws/"
# CRYSTAL_FORGE_HOME=""                         # optional, runtime root (default ~/.crystal-forge)
