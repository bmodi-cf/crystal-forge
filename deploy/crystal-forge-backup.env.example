# Crystal Forge backup configuration — systemd EnvironmentFile.
#
# The installer copies this to /etc/default/crystal-forge-backup on first
# install (and never overwrites it afterwards). Uncomment/edit any line to
# override the built-in defaults baked into the backup script. Every commented
# value is optional; REPO_DIR below is not — see the note on it.

# Absolute path to the checkout holding docker-compose.yml. REQUIRED when the
# backup component is installed WITHOUT the dashboard: the crystal-forge-ensure-postgres
# guard that both units share reads its own config from /etc/default/crystal-forge,
# which only the --dashboard install creates. Without this line that guard cannot
# locate docker-compose.yml and the backup fails before it starts. Harmless when
# the dashboard is installed too (the value is the same checkout).
REPO_DIR=/home/bmodi/work/crystal-forge

# Name of the shared Postgres container (holds the dashboard + all forge DBs).
#PG_CONTAINER=crystal-forge-pg

# Superuser role used for pg_dumpall/pg_dump (local socket auth = trust).
#PG_SUPERUSER=crystal

# Where archives are written (root-owned; ~3 GB steady-state).
#BACKUP_ROOT=/var/backups/crystal-forge

# Retention per tier, in days (grandfather-father-son).
#DAILY_KEEP_DAYS=31     # ~1 month
#WEEKLY_KEEP_DAYS=183   # ~6 months
#MONTHLY_KEEP_DAYS=730  # ~2 years
