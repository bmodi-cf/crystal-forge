# Crystal Forge dashboard configuration — systemd EnvironmentFile.
#
# The installer writes this to /etc/default/crystal-forge on first install, with
# REPO_DIR and NODE_BIN_DIR filled in from the host it ran on, and never
# overwrites it afterwards. Edit it there and `systemctl restart crystal-forge`.
#
# REPO_DIR and NODE_BIN_DIR are REQUIRED: systemd can't interpolate env-file
# values into ExecStart= paths, so /usr/local/bin/crystal-forge-dashboard reads
# them at start time to locate the checkout and the (nvm-installed) Node.

# Absolute path to the checkout the service runs from. Also used by
# crystal-forge-ensure-postgres to find docker-compose.yml.
REPO_DIR=/home/bmodi/work/crystal-forge

# Directory holding the `node` binary that should run the service. nvm installs
# are not on systemd's PATH, so this must be explicit and absolute.
NODE_BIN_DIR=/home/bmodi/.nvm/versions/node/v24.16.0/bin

# Loopback port the dashboard's HTTP server binds. nginx proxies to it.
# (The runtime terminal WebSocket server on :3100 is started by
# instrumentation.ts and is not configured here.)
PORT=3030

# Production build is served from .next; leave as-is unless you know why.
NODE_ENV=production

# Name of the shared Postgres container brought up before start. Keep in sync
# with /etc/default/crystal-forge-backup if you override it.
#PG_CONTAINER=crystal-forge-pg

# Seconds to wait for the Postgres healthcheck before failing the start.
#PG_HEALTH_TIMEOUT=60
